{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      // React Native 0.88 publishes its types only through the `exports` map;
      // point the mapping at that entry so the linked library and the app still
      // agree on one copy.
      "react-native": [
        "./node_modules/react-native/types_generated/index.d.ts"
      ],
      "react-native/*": [
        "./node_modules/react-native/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
