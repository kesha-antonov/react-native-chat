// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`should render <Chat/> and compare with snapshot 1`] = `
<View
  style={
    {
      "flex": 1,
    }
  }
>
  <KeyboardProvider>
    <View
      onLayout={[Function]}
      style={
        [
          {
            "flex": 1,
          },
          {
            "overflow": "hidden",
          },
        ]
      }
      testID="GC_WRAPPER"
    >
      <View
        behavior="translate-with-padding"
        keyboardVerticalOffset={0}
        style={
          {
            "flex": 1,
          }
        }
      >
        <View
          style={
            [
              {
                "flex": 1,
              },
              {
                "opacity": 0,
              },
            ]
          }
          testID="GC_CONTENT"
        />
      </View>
    </View>
  </KeyboardProvider>
</View>
`;

